{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "icrps-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],

  // 本番 custom domain: icrps.mirai-dx-platform.com（ユーザー指定・承認済み 2026-08-01）
  "routes": [
    { "pattern": "icrps.mirai-dx-platform.com", "custom_domain": true }
  ],
  "workers_dev": false,

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  },

  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  "vars": {
    "APP_ENV": "production",
    "APP_URL": "https://icrps.mirai-dx-platform.com"
  },

  // DATABASE_URL / JWT_SECRET / OPENAI_API_KEY 等は wrangler secret put で登録し、このファイルへ書かない

  "env": {
    "preview": {
      "name": "icrps-api-preview",
      "workers_dev": true,
      // 本番 custom domain を Preview に継承させない
      "routes": [],
      "assets": {
        "directory": "../web/dist",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/api/*"]
      },
      "vars": {
        "APP_ENV": "preview",
        "APP_URL": "https://icrps-api-preview.kensan1969.workers.dev"
      }
    },
    "mvp": {
      "name": "icrps-api-mvp",
      "workers_dev": false,
      // MVP / Prototype 専用サブドメイン（デモデータ投入・レビュー用。Access 保護は付けない）
      "routes": [
        { "pattern": "icrps-mvp.mirai-dx-platform.com", "custom_domain": true }
      ],
      "assets": {
        "directory": "../web/dist",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/api/*"]
      },
      "vars": {
        "APP_ENV": "mvp",
        "APP_URL": "https://icrps-mvp.mirai-dx-platform.com",
        // MVP 公開デモ: ログイン認証を一時的に無効化（誰でも閲覧可）。
        // 復旧は "false" に戻して再デプロイするだけ。本番は APP_ENV=production のため常に無効。
        "AUTH_BYPASS": "true"
      }
    }
  }
}
