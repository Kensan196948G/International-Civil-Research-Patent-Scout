# 実行環境
APP_ENV=development
APP_URL=http://localhost:8787

# Neon PostgreSQL（本番は Cloudflare Worker Secret / CI Secret で管理し、リポジトリへコミットしない）
DATABASE_URL=postgresql://user:password@localhost:5432/civil_research

# 認証
JWT_SECRET=change-me-strong-random-value
JWT_EXPIRES_IN=12h

# 登録制御（本番推奨: domain）
# REGISTRATION_MODE=open|domain（open: 誰でも登録可 / domain: 許可ドメインのみ）
# ALLOWED_EMAIL_DOMAINS=example.com,sub.example.co.jp
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com（初回ログイン/登録時に admin へ昇格）
REGISTRATION_MODE=open
ALLOWED_EMAIL_DOMAINS=
BOOTSTRAP_ADMIN_EMAIL=

# AI 利用量の制御（ユーザーあたり1時間の最大呼び出し回数。429 を返す）
AI_RATE_LIMIT_PER_HOUR=100

# AI（未設定時はルールベースのフォールバック要約を使用）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# 外部検索 API（任意・未設定時は該当コネクタを自動スキップ）
CROSSREF_API_URL=https://api.crossref.org
OPENALEX_API_URL=https://api.openalex.org
SERP_API_KEY=

# Espacenet OPS（特許検索・任意・未設定時は自動スキップ）
ESPACENET_OPS_URL=https://ops.epo.org/3.2
ESPACENET_OPS_KEY=
ESPACENET_OPS_SECRET=

# メール通知（任意・未設定時は通知なし）
RESEND_API_KEY=
EMAIL_FROM="ICRPS <noreply@example.com>"
ADMIN_EMAIL=

# 全文検索（任意・未設定時は PostgreSQL trigram）
MEILISEARCH_HOST=
MEILISEARCH_API_KEY=

# Google SSO（任意・未設定時は非表示）
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudflare
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
